# =============================================================================
# agent-loop.env — la configuracion del bucle supervisado.
# =============================================================================
#
# Este fichero se rellena UNA vez y se lee en cada arranque. Sin el, el runtime deduce lo
# deducible y pregunta lo que no puede saber; con el, no pregunta nada.
#
# Se busca, en este orden, y se dice cual se uso:
#   1. $AGENT_LOOP_ENV
#   2. ./agent-loop.env            (la raiz del workspace: donde vive pipeline.agent.kts)
#   3. ../agent-loop.env           (la skill instalada)
#   4. ~/.config/agent-skills/supervised-task-loop.env   (global, para todos tus proyectos)
#
# Las variables del entorno GANAN a este fichero: el fichero es el valor del proyecto, el
# entorno es el override de una vez.
#
# Aqui NO hay secretos. La autenticacion del agente va en su perfil de Claude Code, y las
# credenciales del repositorio en las suyas.

# --- el workspace agéntico: donde trabaja la sesión ----------------------------------------------
# El directorio desde el que el agente ve SUS repositorios. Hay dos formas, y las dos valen:
#
#   un solo proyecto:   el workspace agéntico es el propio proyecto.
#   patron home repo:   el workspace agéntico es el DIRECTORIO PADRE, y el home repo (el que
#                       lleva el backlog) es uno de sus hijos. Desde ahi el agente ve los repos
#                       de producto hermanos, que es lo que quiere.
#
# Vacio = el directorio donde corre el run. Ponlo solo cuando no coincidan.
AGENT_WORKSPACE=

# --- el tablero: la unica autoridad sobre lo que esta hecho --------------------------------------
# El directorio que contiene config.yml (el que la herramienta lee). Si hay varios tableros
# bajo el workspace, este dice cual es el que manda. Si lo dejas vacio, el runtime lo busca:
# en el directorio donde corre el run, o en un unico subdirectorio que lo tenga.
AGENT_BOARD=

# --- el agente que abre cada sesion -------------------------------------------------------------
# El perfil de Claude Code con el que se abre cada sesion. Cada perfil vive en
# ~/.config/claude-profiles/<nombre>.json y trae su propio modelo y su autenticacion.
AGENT_PROFILE=cuenta-6

# 1 activa los hooks de plugin (y apaga el login de claude.ai: no lo actives sin saber por que).
AGENT_BARE=0

# --- el ritmo del bucle ---------------------------------------------------------------------------
# Cuantas sesiones abre un run.
AGENT_MAX_TASKS=3
# El techo de una sesion, en minutos. Si se pasa, la iteracion se queda a medias y el handoff
# dice donde: es mejor que una sesion sin techo.
AGENT_TASK_TIMEOUT_MIN=90

# --- las skills que la sesion debe leer ----------------------------------------------------------
# Las skills que el objetivo de la sesion tiene que aplicar, por ruta absoluta al SKILL.md,
# separadas por dos puntos. Vacio = la sesion las busca por su cuenta en los directorios de
# skills de su instalacion (y las nombra en el prompt).
AGENT_SKILLS=

# --- donde corre el trabajo largo -----------------------------------------------------------------
# La slice de recursos donde van los trabajos que tardan (Gradle, las puertas). Fuera de su
# slice, el vigilante de la maquina los mata.
AGENT_SLICE=dev-jvm.slice
